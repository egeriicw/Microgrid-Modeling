                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choices"
          },
          "columns": {
            "additionalProperties": {
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]{0,127}$",
              "type": "string"
            },
            "maxProperties": 2,
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "resstock",
                "comstock"
              ]
