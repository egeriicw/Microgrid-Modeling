      "VersionOut": {
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "based_on": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Based On"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "None for version 0 (packaged)",
            "title": "Created By"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "based_on",
          "note",
          "created_by",
          "created_at",
          "active"
        ],
        "title": "VersionOut",
        "type": "object"
      }
    },
