# Copy to deploy/.env and adjust. Consumed by docker-compose + settings.py (FR-D6).

# --- database (compose `db` service) ---
POSTGRES_USER=microgrid
POSTGRES_PASSWORD=microgrid
POSTGRES_DB=microgrid

# --- api / worker ---
DATABASE_URL=postgresql+psycopg://microgrid:microgrid@db:5432/microgrid
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=microgrid
S3_SECRET_KEY=microgrid-secret
S3_BUCKET=snlg-artifacts
API_TOKEN=dev-token-change-me
MAX_RUNS_CEILING=500
PRESIGN_TTL_SECONDS=900
DATA_DIR=/data
LOG_LEVEL=INFO

# --- worker runner mode: subprocess | inprocess | mock (mock = CI/tests) ---
MICROGRID_RUNNER_MODE=inprocess

# --- web (browser-side; must be reachable from the host) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
