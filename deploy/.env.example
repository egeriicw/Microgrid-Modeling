# Copy to deploy/.env (git-ignored). DEVELOPMENT ONLY values: change anything you ever expose beyond this laptop.
# Consumed by `make up` / docker compose (--env-file deploy/.env).

# --- host paths ---
# Folder with the ResStock/ComStock Parquet data on the host. Mounted READ-ONLY at /data; never copied into an image.
# Relative paths are relative to the repo root.
MICROGRID_DATA_DIR=./data

# --- host ports (all bound to 127.0.0.1 only) ---
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# --- database ---
POSTGRES_USER=microgrid
POSTGRES_DB=microgrid
POSTGRES_PASSWORD=dev-only-postgres-password

# --- api / worker ---
JWT_SECRET=dev-only-jwt-secret-change-me
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2

# --- memory ceilings (estimates; tune after the story 1.11 measurements) ---
DB_MEM_LIMIT=2g
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=8g
