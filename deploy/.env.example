# Copy to deploy/.env (git-ignored). DEVELOPMENT ONLY values: change anything you ever expose beyond this laptop.
# Consumed by `make up` / docker compose (--env-file deploy/.env).

# --- host paths ---
# Folder with the ResStock/ComStock Parquet data on the host. Mounted READ-ONLY at /data; never copied into an image.
# Relative paths are relative to the repo root.
MICROGRID_DATA_DIR=./data

# --- host ports (all bound to 127.0.0.1 only) ---
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# --- database ---
POSTGRES_USER=microgrid
POSTGRES_DB=microgrid
POSTGRES_PASSWORD=dev-only-postgres-password

# --- api / worker ---
# (compose maps these to the API's MICROGRID_* settings: MICROGRID_DATABASE_URL, MICROGRID_REDIS_URL, MICROGRID_JWT_SECRET,
#  MICROGRID_API_KEYS)
JWT_SECRET=dev-only-jwt-secret-change-me
# Who may call the API: a JSON list of {"subject","role","key"}; role is admin, client or demo; key at least 16 characters.
# Send a key as the header `Authorization: Bearer <key>`. Keep the single quotes (the value contains double quotes).
API_KEYS='[{"subject":"dev-admin","role":"admin","key":"dev-only-admin-key-change-me"},{"subject":"dev-client","role":"client","key":"dev-only-client-key-change-me"}]'
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2

# --- which data files the app reads, temperature, request limits (all OPTIONAL) ---
# Every line in this section is commented out, so the app uses the default shown. To change one, remove the "# " at
# the start of the line and edit the value. To go back to the default, put the "# " back (comment it out). Never
# leave a line empty ("NAME=" with nothing after it): an empty value counts as "set", and the app refuses to start.
# The app also refuses a setting it would not use, and `make up` refuses a MICROGRID_ name it does not know (a typo
# would otherwise be silently ignored). A variable of the same name exported in your shell wins over this file.
# After a change: make down && make up. Guide: docs/runbooks/local-stack.md, "Telling the app which data files to use".
#
# Building-characteristics spreadsheets: plain file NAMES (no folders) inside the "background" folder of your data
# folder (MICROGRID_DATA_DIR above). See the real names with:  ls data/background
# The defaults are the names your copy is believed to use [verify]; if `make smoke` or http://127.0.0.1:8000/api/v1/ready
# says data_files is not ok, set the names you see.
# MICROGRID_RESSTOCK_CHARS_FILE=DC_upgrade0.xlsx
# MICROGRID_COMSTOCK_CHARS_FILE=DC_upgrade0_agg.xlsx
#
# Outdoor temperature: OFF ("none") until we confirm where your NREL data keeps it [verify with the data inspector
# report]. Results then say plainly that no temperature is available. The other choices:
#   timeseries_column  a temperature column inside every building's load file: also set _COLUMN and _UNITS.
#   weather_file       a separate weather file: also set _WEATHER_FILE (a path INSIDE the data folder, e.g.
#                      weather/DC_2018.csv), _TIME_COLUMN, _COLUMN and _UNITS.
# Set ONLY the lines your choice needs; any other temperature line left uncommented stops the app at startup.
# The column names below are examples, not the real NREL names [verify].
# MICROGRID_TEMPERATURE_SOURCE=none
# MICROGRID_TEMPERATURE_COLUMN=out.site_outdoor_air_temperature
# MICROGRID_TEMPERATURE_UNITS=F
# MICROGRID_TEMPERATURE_WEATHER_FILE=weather/DC_2018.csv
# MICROGRID_TEMPERATURE_TIME_COLUMN=date_time
#
# Largest request the API accepts, in bytes (default 1 MiB). Bigger requests are refused with "413 too large".
# MICROGRID_MAX_REQUEST_BYTES=1048576
#
# Turn features on or off per role, as JSON (keep the single quotes). The example lets the `client` role use
# attribute filters ("filters.use"); without this line clients cannot. Unknown roles or features stop the app.
# MICROGRID_PERMISSION_OVERRIDES='{"client":{"filters.use":true}}'

# --- memory ceilings (estimates; tune after the story 1.11 measurements) ---
DB_MEM_LIMIT=2g
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=8g
