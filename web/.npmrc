# Needed: without it `npm install` crashes inside npm's resolver (Cannot read properties of null (reading 'edgesOut')) and
# `npm ci` rejects the lockfile (vite's optional peer yaml@^2 vs yaml@1.10.3 pulled in by @emotion/babel-plugin via MUI).
# No runtime peer is actually unmet; `npm ls` reports clean. Revisit when MUI/emotion move to yaml 2.
legacy-peer-deps=true
